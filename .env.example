# Copy to .env for local use. Never commit .env.
# In Cloudflare (Workers & Pages → this Worker → Settings):
#   KEYSTATIC_* secrets → Variables and Secrets (runtime), type Secret.
#   PUBLIC_* values     → Build → Variables and secrets (build time), because they are baked into the build.

# Keystatic GitHub App client ID. Written by the GitHub App setup at /keystatic. Cloudflare: secret.
KEYSTATIC_GITHUB_CLIENT_ID=
# Keystatic GitHub App client secret. Written by the setup. Cloudflare: secret.
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Random string Keystatic uses to sign login sessions. Written by the setup. Cloudflare: secret.
KEYSTATIC_SECRET=
# The GitHub App's slug (the name in its URL). Written by the setup. Cloudflare: build variable.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# GitHub owner of the content repo. Defaults to Benson-Gitau. Cloudflare: build variable.
PUBLIC_KEYSTATIC_REPO_OWNER=
# GitHub repo name. Defaults to portfolio. Cloudflare: build variable.
PUBLIC_KEYSTATIC_REPO_NAME=
# Live site URL with https, e.g. https://example.com. Drives canonical URLs, share images and the sitemap. Cloudflare: build variable.
PUBLIC_SITE_URL=

# Local only: set to "github" to run Keystatic in GitHub mode during dev. `npm run dev:github` does this for you.
PUBLIC_KEYSTATIC_STORAGE=

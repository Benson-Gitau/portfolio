# Copy to .env for local use. Never commit .env.
# PUBLIC_* values are Workers Builds build variables: Worker → Settings → Build → Variables and secrets (baked into the build).
# Keystatic uses Keystatic Cloud (project benson-portfolio/portfolio): no Keystatic secrets anywhere.

# Live site URL: https://bensongitau.dev (apex, https, no trailing slash). Drives canonical URLs, share images and the sitemap. Build variable (optional; this is the default).
PUBLIC_SITE_URL=

# Local only: set to "cloud" to run Keystatic in Cloud mode during dev. `npm run dev:cloud` does this for you.
PUBLIC_KEYSTATIC_STORAGE=

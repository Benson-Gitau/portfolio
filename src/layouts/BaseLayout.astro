---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B1220" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Runs before first paint so the saved theme never flashes. -->
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {}
        var theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <!-- UTM values wait in sessionStorage for the booking embed. -->
    <script is:inline>
      (function () {
        try {
          var from = new URLSearchParams(location.search);
          var keep = new URLSearchParams();
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach(function (key) {
            var value = from.get(key);
            if (value) keep.set(key, value);
          });
          if (keep.toString()) sessionStorage.setItem('utm', keep.toString());
        } catch (e) {}
      })();
    </script>

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-instrument" preload />
    <Font cssVariable="--font-geist-mono" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

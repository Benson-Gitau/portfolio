---
import BaseLayout from './BaseLayout.astro';
import BookingModal from '../components/BookingModal.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import type { ResolvedImage } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  /** Landing pages: logo and Book a call only, no footer links. */
  minimal?: boolean;
  noindex?: boolean;
  shareImage?: ResolvedImage | null;
}
const { title, description, minimal = false, noindex = false, shareImage } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex} shareImage={shareImage}>
  <slot name="head" slot="head" />
  <Nav minimal={minimal} />
  <main id="main"><slot /></main>
  <Footer minimal={minimal} />
  <BookingModal />
</BaseLayout>

<style>
  /* Top wash behind the header and hero; bottom wash behind the closing call to action
     and the footer. Body backgrounds, so neither starts or stops on a visible edge. */
  :global(body) {
    background-color: var(--page);
    background-image: var(--wash-top), var(--wash-bottom);
    background-repeat: no-repeat;
    background-position: top center, top center, bottom center;
    background-size:
      100% min(1100px, 125vh),
      100% min(1100px, 125vh),
      100% 1000px;
  }
</style>

<script>
  import '../lib/reveal';
</script>

---
import BaseLayout from './BaseLayout.astro';
import BookingModal from '../components/BookingModal.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
  /** Landing pages: logo and Book a call only, no footer links. */
  minimal?: boolean;
}
const { title, description, minimal = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Nav minimal={minimal} />
  <main id="main"><slot /></main>
  <Footer minimal={minimal} />
  <BookingModal />
</BaseLayout>

<script>
  import '../lib/reveal';
</script>

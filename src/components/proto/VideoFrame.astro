---
import photo from '../../assets/photos/hero/introVideo/poster/image.png';

interface Props {
  ratio?: string;
  position?: string;
  transcript?: boolean;
}
const { ratio = '4 / 5', position = '50% 22%', transcript = true } = Astro.props;
---

<figure class="vf">
  <div class="frame glass">
    <div class="poster" style={`aspect-ratio:${ratio}`}>
      <img src={photo.src} width={photo.width} height={photo.height} alt="Benson Gitau smiling, in a dark suit and glasses" style={`object-position:${position}`} fetchpriority="high" />
      <button type="button" class="play" aria-label="Play video: 60-second intro">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.53.85l10.5-6.5a1 1 0 0 0 0-1.7L9.53 4.65A1 1 0 0 0 8 5.5Z"></path></svg>
      </button>
      <span class="dur">60s</span>
    </div>
  </div>
  {transcript && (
    <button type="button" class="transcript">Read transcript</button>
  )}
</figure>

<style>
  .vf {
    margin: 0;
    min-width: 0;
  }
  .frame {
    padding: 0.5rem;
    border-radius: var(--radius-lg);
  }
  .poster {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    cursor: pointer;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.3);
    transition: transform var(--dur-micro) var(--ease-out);
  }
  .play:active {
    transform: scale(0.95);
  }
  .dur {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    background: #0b1220;
    color: #f5f7fa;
    font-family: var(--font-geist-mono);
    font-size: 0.8125rem;
  }
  .transcript {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
</style>

---
import ThemeToggle from '../ThemeToggle.astro';
---

<header class="pnav glass">
  <a class="brand" href="#top">Benson Gitau</a>
  <nav aria-label="Main">
    <a href="#work">Work</a>
    <a href="#services">Services</a>
    <a href="#process">Process</a>
    <a href="#about">About</a>
  </nav>
  <div class="end">
    <ThemeToggle />
    <button type="button" class="book">Book a call</button>
    <button type="button" class="menu" aria-label="Open menu">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg>
    </button>
  </div>
</header>

<style>
  .pnav {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.75rem;
    padding: 0.375rem 0.5rem 0.375rem 1.25rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.14);
  }
  .brand {
    font-family: var(--font-geist);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  nav {
    display: none;
    gap: 0.25rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.875rem;
    font-family: var(--font-geist);
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--text);
    border-radius: var(--radius-pill);
  }
  .end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .book {
    min-height: 44px;
    padding-inline: 1.125rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-geist);
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
    cursor: pointer;
    transition: transform var(--dur-micro) var(--ease-out);
  }
  .book:active {
    transform: scale(0.97);
  }
  .menu {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--text) 45%, var(--bg));
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  @media (max-width: 767px) {
    .book {
      display: none;
    }
  }
  @media (min-width: 768px) {
    nav {
      display: flex;
    }
    .menu {
      display: none;
    }
  }
</style>

---
// Problem and Outcomes: the same ledger, first open, then closed.
import Heading from '../Heading.astro';
import Tick from '../Tick.astro';

interface Props {
  problem: { heading: string; cards: readonly { title: string; text: string }[]; closingLine: string };
  outcomes: { heading: string; items: readonly { title: string; text: string }[] };
}
const { problem, outcomes } = Astro.props;
---

<section class="problem section wrap">
  <Heading class="h2 lead" text={problem.heading} />
  <div class="rows">
    <ul>
      {problem.cards.map((card) => (
        <li>
          <Tick open class="open" />
          <div>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="closing">{problem.closingLine}</p>
  </div>
</section>

<section class="outcomes">
  <div class="section wrap">
    <Heading class="h2" text={outcomes.heading} />
    <ul>
      {outcomes.items.map((item) => (
        <li>
          <Tick class="done" />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .problem {
    display: grid;
    gap: 2.5rem;
  }
  ul {
    display: grid;
  }
  .rows li {
    display: flex;
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .rows li:first-child {
    border-top: 1px solid var(--rule);
  }
  .rows :global(.open) {
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.125rem;
    color: var(--danger);
  }
  h3 {
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    letter-spacing: -0.015em;
  }
  li p {
    margin-top: 0.5rem;
    color: var(--text-muted);
  }
  .closing {
    margin-top: 2rem;
    font-family: var(--font-geist);
    font-size: clamp(1.375rem, 2.6vw, 2.125rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--accent-text);
  }
  .outcomes {
    background: var(--surface);
  }
  .outcomes ul {
    gap: 2.5rem;
    margin-top: 3rem;
  }
  .outcomes li {
    padding-top: 1.25rem;
    border-top: 2px solid var(--line-strong);
  }
  .outcomes :global(.done) {
    width: 2rem;
    height: 2rem;
    margin-bottom: 1rem;
    color: var(--teal-text);
  }
  @media (min-width: 1024px) {
    .problem {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
    .lead {
      position: sticky;
      top: 6rem;
    }
    .outcomes ul {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
  }
</style>

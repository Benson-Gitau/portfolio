---
import Heading from '../Heading.astro';

interface Props {
  process: { heading: string; steps: readonly { title: string; text: string }[] };
}
const { process } = Astro.props;
---

<section class="process" id="process">
  <div class="section wrap">
    <Heading class="h2" text={process.heading} />
    <ol>
      {process.steps.map((step) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--surface);
  }
  ol {
    display: grid;
    margin-top: 3rem;
    counter-reset: step;
  }
  li {
    position: relative;
    padding: 0 0 2rem 3rem;
    counter-increment: step;
  }
  /* The numbered line is real information: steps run in this order. */
  li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    background: var(--bg);
    border: 2px solid var(--line-strong);
    font-family: var(--font-geist-mono);
    font-size: 0.875rem;
    font-weight: 500;
  }
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(1rem - 1px);
    top: 2rem;
    bottom: 0;
    width: 2px;
    background: var(--line-strong);
  }
  /* The line between steps grows as each step arrives. */
  li:not(:last-child)::after {
    transform-origin: top;
  }
  li[data-rv='out']::after {
    transform: scaleY(0);
  }
  li[data-rv='in']::after {
    transition: transform var(--dur-reveal) var(--ease-out);
    transition-delay: inherit;
  }
  h3 {
    font-size: 1.375rem;
    letter-spacing: -0.015em;
    line-height: 2rem;
  }
  p {
    margin-top: 0.375rem;
    color: var(--text-muted);
  }
  @media (min-width: 1024px) {
    ol {
      grid-template-columns: repeat(5, 1fr);
      column-gap: 1.5rem;
    }
    li {
      padding: 3rem 0 0;
    }
    li[data-rv='out']::after {
      transform: scaleX(0);
    }
    li:not(:last-child)::after {
      transform-origin: left;
      left: 2rem;
      right: -1.5rem;
      top: calc(1rem - 1px);
      bottom: auto;
      width: auto;
      height: 2px;
    }
  }
</style>

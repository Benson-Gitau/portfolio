---
import Heading from '../Heading.astro';

interface Props {
  process: { heading: string; steps: readonly { title: string; text: string }[] };
}
const { process } = Astro.props;
---

<section class="process section" id="process">
  <div class="wrap head">
    <p class="kicker">/ Process</p>
    <Heading class="h2" text={process.heading} />
  </div>
  <ol class="wrap">
    {process.steps.map((step, i) => (
      <li class="soft-card">
        <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
        {i < process.steps.length - 1 && (
          <svg class="link" viewBox="0 0 120 80" fill="none" aria-hidden="true">
            <path d="M6 66C26 18 58 8 72 26c12 16-10 34-20 20-10-15 22-40 62-34" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
            <circle cx="6" cy="66" r="5" fill="currentColor"></circle>
            <circle cx="114" cy="12" r="5" fill="currentColor"></circle>
          </svg>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .head {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  ol {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }
  li {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding: 1.5rem;
  }
  li:nth-child(odd) { rotate: -0.75deg; }
  li:nth-child(even) { rotate: 0.75deg; }
  .num {
    font-family: var(--font-geist);
    font-size: clamp(2.75rem, 4.6vw, 4.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  h3 {
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  p {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .link {
    display: none;
  }
  @media (min-width: 1024px) {
    ol {
      grid-template-columns: repeat(5, 1fr);
      gap: clamp(0.75rem, 1.4vw, 1.25rem);
      padding-bottom: 4rem;
    }
    li {
      min-height: 22rem;
    }
    li:nth-child(odd) { rotate: -2deg; }
    li:nth-child(even) { rotate: 2deg; translate: 0 4rem; }
    .link {
      position: absolute;
      top: 0.5rem;
      right: -2.75rem;
      z-index: 1;
      display: block;
      width: 6rem;
      color: var(--teal-text);
      pointer-events: none;
    }
    li:nth-child(even) .link {
      top: auto;
      bottom: 62%;
    }
  }
</style>

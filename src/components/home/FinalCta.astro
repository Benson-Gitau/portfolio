---
import { getHome } from '../../lib/content';
const { finalCta } = await getHome();
---

<section class="final wrap" id="book" aria-labelledby="book-title">
  <h2 id="book-title" data-reveal>{finalCta.heading}</h2>
  <p class="text" data-reveal>{finalCta.text}</p>
  <a class="btn btn-primary" href="#book" data-book data-reveal>{finalCta.buttonLabel}</a>
</section>

<style>
  .final {
    display: grid;
    justify-items: center;
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    text-align: center;
  }
  h2 {
    max-width: 14ch;
    font-size: clamp(2.5rem, 5.5vw, 4.75rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .text {
    max-width: 44ch;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .btn {
    margin-top: 2rem;
  }
  @media (max-width: 759px) {
    .final {
      padding-block: 3.5rem;
    }
  }
</style>

---
import BookingEmbed from '../BookingEmbed.astro';
import Heading from '../Heading.astro';
import { getSettings } from '../../lib/content';

interface Props {
  cta: { heading: string; text: string };
}
const { cta } = Astro.props;
const settings = await getSettings();
---

<section class="final" id="contact">
  <div class="inner section wrap">
    <div class="copy">
      <Heading class="h2" text={cta.heading} />
      <p>{cta.text}</p>
    </div>
    <div class="booking-col">
      <div class="calendar glass"><BookingEmbed loadOn="view" /></div>
      <ul class="links">
        <li><a class="text-link" href={`mailto:${settings.email}`}>{settings.email}</a></li>
        <li><a class="text-link" href={settings.linkedinUrl}>LinkedIn</a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .final {
    scroll-margin-top: 4rem;
  }
  .inner {
    display: grid;
    gap: 2.5rem;
  }
  .booking-col {
    min-width: 0;
  }
  .copy p {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    margin-top: 1rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    overflow-wrap: anywhere;
  }
  .calendar {
    min-width: 0;
    padding: 0.5rem;
    border-radius: var(--radius-lg);
  }
  @media (min-width: 1024px) {
    .inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
    .copy {
      position: sticky;
      top: 6rem;
    }
  }
</style>

---
import Heading from '../Heading.astro';

interface Props {
  services: { heading: string; items: readonly { title: string; text: string; priceFrom: string }[] };
}
const { services } = Astro.props;
---

<section class="services section wrap" id="services">
  <div class="head">
    <p class="kicker">/ Services</p>
    <Heading class="h2" text={services.heading} />
  </div>
  <ul class="bento">
    {services.items.map((item) => (
      <li class="cell soft-card">
        <h3>{item.title}</h3>
        <p>{item.text}</p>
        {item.priceFrom && <p class="price">From {item.priceFrom}</p>}
      </li>
    ))}
  </ul>
</section>

<style>
  .head {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .bento {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2.2vw, 2rem);
  }
  h3 {
    font-size: clamp(1.25rem, 1.9vw, 1.625rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .cell p {
    color: var(--text-muted);
  }
  .price {
    margin-top: auto;
    font-family: var(--font-geist-mono);
  }
  .cell:first-child {
    justify-content: flex-end;
    border-color: transparent;
    background: var(--accent);
    color: var(--on-accent);
  }
  .cell:first-child h3 {
    font-size: clamp(2rem, 4vw, 3.75rem);
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .cell:first-child p {
    color: var(--on-accent);
    font-size: 1.0625rem;
  }
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(6, 1fr);
    }
    .cell { grid-column: span 2; min-height: 14rem; }
    .cell:nth-child(1) { grid-column: span 4; }
    .cell:nth-child(6),
    .cell:nth-child(7) { grid-column: span 3; }
  }
</style>

---
import Heading from '../Heading.astro';

interface Props {
  services: { heading: string; items: readonly { title: string; text: string; priceFrom: string }[] };
}
const { services } = Astro.props;
---

<section class="services section wrap" id="services">
  <Heading class="h2" text={services.heading} />
  <ul class="bento">
    {services.items.map((item) => (
      <li class="cell">
        <h3>{item.title}</h3>
        <p>{item.text}</p>
        {item.priceFrom && <p class="price">From {item.priceFrom}</p>}
      </li>
    ))}
  </ul>
</section>

<style>
  .bento {
    display: grid;
    gap: 0.75rem;
    margin-top: 3rem;
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2.2vw, 2rem);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  h3 {
    font-size: clamp(1.25rem, 1.9vw, 1.625rem);
    letter-spacing: -0.02em;
  }
  .cell p {
    color: var(--text-muted);
  }
  .price {
    margin-top: auto;
    color: var(--accent-text) !important;
    font-family: var(--font-geist-mono);
  }
  /* The lead service is the most common starting point, so it takes the focus. */
  .cell:first-child {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent-text) 45%, transparent);
  }
  .cell:first-child h3 {
    font-size: clamp(1.75rem, 3.4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .cell:first-child p {
    color: var(--text);
    font-size: 1.0625rem;
  }
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(6, 1fr);
    }
    .cell { grid-column: span 2; }
    .cell:nth-child(1) { grid-column: span 4; }
    .cell:nth-child(6),
    .cell:nth-child(7) { grid-column: span 3; }
  }
</style>

---
// An editorial ruled list rather than cards: the page already has card rows in
// Process and Work, and services read best as a scannable menu.
import SectionHead from '../SectionHead.astro';
import { getHome } from '../../lib/content';
const { services } = await getHome();
---

<section class="services wrap section" id="services" aria-labelledby="services-title">
  <SectionHead eyebrow={services.eyebrow} heading={services.heading} id="services-title" />

  <ul class="list">
    {services.items.map((item) => (
      <li class="row" data-reveal>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
        {item.priceFrom && <p class="price">From {item.priceFrom}</p>}
      </li>
    ))}
  </ul>
</section>

<style>
  .list {
    max-width: 1040px;
    margin: 3.5rem auto 0;
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr) auto;
    gap: 0.5rem 2.5rem;
    align-items: baseline;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .row p {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .row .price {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (max-width: 759px) {
    .list {
      margin-top: 2.5rem;
    }
    .row {
      grid-template-columns: 1fr;
      padding-block: 1.25rem;
    }
    h3 {
      font-size: 1.125rem;
    }
  }
</style>

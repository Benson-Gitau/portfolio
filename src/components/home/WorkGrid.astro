---
import { Image } from 'astro:assets';
import Heading from '../Heading.astro';
import Placeholder from '../Placeholder.astro';
import Tick from '../Tick.astro';
import { getFeaturedProjects } from '../../lib/content';

interface Props {
  work: { heading: string; intro: string; otherWork: string; filters: { all: string; wellness: string; ecommerceOps: string } };
}
const { work } = Astro.props;
const projects = await getFeaturedProjects();
const filters = [
  { value: 'all', label: work.filters.all },
  { value: 'wellness', label: work.filters.wellness },
  { value: 'ecommerce-ops', label: work.filters.ecommerceOps },
];
---

<section class="work section wrap" id="work">
  <div class="head">
    <Heading class="h2" text={work.heading} />
    <p>{work.intro}</p>
  </div>
  <div class="filters" role="group" aria-label="Filter projects">
    {filters.map((filter, i) => (
      <button type="button" class="filter" data-filter={filter.value} aria-pressed={i === 0 ? 'true' : 'false'}>{filter.label}</button>
    ))}
  </div>
  <ul class="grid" data-grid>
    {projects.map((project) => (
      <li class="item" data-lane={project.lane}>
        <a class="card" href={`/work/${project.slug}`}>
          <div class="cover">
            {project.cover ? (
              <Image src={project.cover.src} alt={project.cover.alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" />
            ) : (
              <ul class="ledger" aria-hidden="true">
                {project.steps.slice(0, 3).map((step) => (
                  <li><Tick class="t" /><span><Placeholder text={step.title} /></span></li>
                ))}
              </ul>
            )}
          </div>
          <div class="meta">
            <span class:list={['mono-label', project.isDemo ? 'demo' : 'client']}>{project.typeLabel}</span>
            <span class="industry">{project.industry}</span>
          </div>
          <h3>{project.title}</h3>
          <p class:list={['result', { big: !project.isDemo }]}>{project.cardResult}</p>
          {project.toolNames.length > 0 && (
            <ul class="tools">{project.toolNames.slice(0, 4).map((tool) => <li class="chip">{tool}</li>)}</ul>
          )}
        </a>
      </li>
    ))}
  </ul>
  <p class="other">{work.otherWork}</p>
</section>

<style>
  .head {
    display: grid;
    gap: 1rem;
  }
  .head p {
    color: var(--text-muted);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  /* Small tactile control: pressed state changes fill and text, not just shadow. */
  .filter {
    min-height: 44px;
    padding-inline: 1rem;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: var(--tactile);
    font-family: var(--font-geist);
    font-weight: 500;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: transform var(--dur-micro) var(--ease-out);
  }
  .filter:active {
    transform: scale(0.97);
  }
  .filter[aria-pressed='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
    box-shadow: none;
  }
  .grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .item[hidden] {
    display: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.75rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: transform var(--dur-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-4px);
    }
  }
  .cover {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg);
  }
  .cover :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
  }
  .ledger {
    display: grid;
    padding: 0.5rem 1.25rem;
  }
  .ledger li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
    line-height: 1.3;
  }
  .ledger li:last-child {
    border-bottom: 0;
  }
  .ledger :global(.t) {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--teal-text);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding-inline: 0.5rem;
  }
  .demo {
    color: var(--teal-text);
  }
  .client {
    color: var(--accent-text);
  }
  .industry {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  h3 {
    margin-top: 0.75rem;
    padding-inline: 0.5rem;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    letter-spacing: -0.02em;
  }
  .result {
    margin-top: 0.75rem;
    padding-inline: 0.5rem;
    color: var(--text-muted);
    font-family: var(--font-geist-mono);
    font-size: 0.875rem;
  }
  .result.big {
    color: var(--accent-text);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 500;
    line-height: 1.2;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
    padding: 1rem 0.5rem 0.5rem;
  }
  .other {
    margin-top: 2rem;
    max-width: 90ch;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: clamp(2rem, 4vw, 4rem);
      align-items: end;
    }
    .grid {
      grid-template-columns: repeat(12, 1fr);
    }
    /* Alternating widths keep the row from reading as a template strip. */
    .item { grid-column: span 5; }
    .item:nth-child(4n + 1),
    .item:nth-child(4n + 4) { grid-column: span 7; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-lane]');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const value = button.dataset.filter;
      buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      items.forEach((item) => {
        item.hidden = value !== 'all' && item.dataset.lane !== value;
      });
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      [...items]
        .filter((item) => !item.hidden)
        .forEach((item, i) => {
          item.animate(
            [
              { opacity: 0, transform: 'translateY(12px)' },
              { opacity: 1, transform: 'none' },
            ],
            { duration: 280, delay: i * 40, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'backwards' },
          );
        });
    });
  });
</script>

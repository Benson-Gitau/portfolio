---
import { Image } from 'astro:assets';
import SectionHead from '../SectionHead.astro';
import { getFeaturedProjects, getHome } from '../../lib/content';

const [projects, home] = await Promise.all([getFeaturedProjects(), getHome()]);
const items = projects.slice(0, 4);
const dev = import.meta.env.DEV;
---

<section class="work wrap section" id="work" aria-labelledby="work-title">
  <SectionHead eyebrow={home.work.eyebrow} heading={home.work.heading} id="work-title" />

  <ul class="grid">
    {items.map((project) => {
      const Tag = project.hasPage ? 'a' : 'div';
      return (
        <li data-reveal>
          <Tag class="card" href={project.hasPage ? `/work/${project.slug}` : undefined}>
            <div class="frame">
              {project.cover ? (
                <Image
                  class="cover"
                  src={project.cover.src}
                  alt={project.cover.alt}
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 860px) 560px, 90vw"
                  format="webp"
                  quality={80}
                />
              ) : (
                <span class="cover empty mono-label">{dev && `[Cover · ${project.cardTitle}]`}</span>
              )}
            </div>
            <div class="meta">
              <h3>{project.cardTitle}</h3>
              <ul class="tags" aria-label="Tools">
                {project.toolNames.slice(0, 2).map((name) => <li class="tag">{name}</li>)}
              </ul>
            </div>
          </Tag>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 32px;
    margin-top: 3.5rem;
  }
  .card {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .frame {
    padding: 28px;
    border-radius: 20px;
    background: var(--soft);
  }
  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: var(--shadow-image);
    transition:
      transform 500ms var(--ease-out),
      box-shadow 500ms var(--ease-out);
  }
  .empty {
    display: grid;
    place-items: center;
    padding: 1rem;
    border: 1.5px dashed color-mix(in srgb, var(--ink) 22%, transparent);
    background: color-mix(in srgb, var(--card) 45%, transparent);
    box-shadow: none;
    color: var(--muted);
    font-weight: 400;
    text-align: center;
  }
  @media (hover: hover) and (pointer: fine) {
    a.card:hover .cover:not(.empty) {
      transform: translateY(-6px) scale(1.02);
      box-shadow: 0 36px 60px -32px rgb(0 0 0 / 0.45);
    }
    a.card:hover h3 {
      text-decoration: underline;
      text-underline-offset: 4px;
      text-decoration-thickness: 1px;
    }
  }
  a.card:focus-visible {
    outline-offset: 6px;
    border-radius: 22px;
  }
  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .tags {
    display: flex;
    flex: none;
    gap: 0.375rem;
  }
  @media (max-width: 759px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      margin-top: 2.5rem;
    }
    .frame {
      padding: 16px;
    }
    .meta {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }
  }
</style>

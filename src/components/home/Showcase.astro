---
// The orange panel of work. Decorative preview: the real, linked cards are in the Work section.
import { Image } from 'astro:assets';
import Placeholder from '../Placeholder.astro';
import { getFeaturedProjects } from '../../lib/content';

const projects = (await getFeaturedProjects()).slice(0, 6);
---

<div class="wrap">
  <div class="panel" aria-hidden="true">
    {projects.map((project) => (
      <div class="tile">
        {project.cover ? (
          <Image src={project.cover.src} alt="" widths={[400, 700]} sizes="(min-width: 768px) 30vw, 90vw" format="webp" />
        ) : (
          <>
            <span class="mono-label">{project.typeLabel}</span>
            <p>{project.title}</p>
            {import.meta.env.DEV && <Placeholder text={`[PROJECT_COVER: ${project.slug}]`} />}
          </>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .panel {
    display: grid;
    gap: 0.75rem;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    border-radius: var(--radius-lg);
    background: var(--accent);
  }
  .tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    min-height: 10rem;
    overflow: hidden;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .tile:has(img) {
    padding: 0;
  }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile .mono-label {
    color: var(--teal-text);
  }
  .tile p {
    font-family: var(--font-geist);
    font-size: clamp(1.125rem, 1.7vw, 1.625rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  @media (min-width: 768px) {
    .panel {
      grid-template-columns: repeat(3, 1fr);
    }
    .tile {
      min-height: clamp(13rem, 21vw, 20rem);
    }
    .tile:nth-child(2) { grid-row: span 2; }
    .tile:nth-child(5) { grid-column: 3; grid-row: 2 / span 1; }
    .tile:nth-child(6) { grid-column: 1 / span 3; min-height: 8rem; }
  }
</style>

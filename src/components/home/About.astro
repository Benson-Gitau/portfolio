---
import { Image } from 'astro:assets';
import Heading from '../Heading.astro';
import Placeholder from '../Placeholder.astro';
import { getSettings, hasPlaceholder, resolveImage } from '../../lib/content';

interface Props {
  about: {
    heading: string;
    text: string;
    photo: { image: string | null; alt: string };
    agencyLine: string;
    timeline: readonly { role: string; where: string; when: string }[];
  };
}
const { about } = Astro.props;
const [settings, photo] = await Promise.all([getSettings(), resolveImage(about.photo, 'about photo')]);
const agencyLine = about.agencyLine.replace('[AGENCY NAME]', settings.agencyName);
const agencyLinked = !hasPlaceholder(settings.agencyUrl) && Boolean(settings.agencyUrl);
const socials = [
  { href: settings.linkedinUrl, label: 'LinkedIn' },
  { href: settings.githubUrl, label: 'GitHub' },
  { href: settings.xUrl, label: 'X' },
];
---

<section class="about section wrap" id="about">
  <div class="head">
    <p class="kicker">/ About</p>
    <Heading class="h2" text={about.heading} />
  </div>
  <div class="grid">
    <div class="left">
      {photo && (
        <div class="photo">
          <Image src={photo.src} alt={photo.alt} widths={[500, 800, 1100]} sizes="(min-width: 1024px) 48vw, 100vw" format="webp" quality={78} />
        </div>
      )}
      <div class="id">
        <p>{settings.footerRole}</p>
        <ul>{socials.map((social) => <li><a class="text-link" href={social.href}>{social.label}</a></li>)}</ul>
      </div>
    </div>
    <div class="copy">
      <p class="text">{about.text}</p>
      <p class="agency">
        {agencyLinked ? <a class="text-link" href={settings.agencyUrl}>{agencyLine}</a> : <Placeholder text={agencyLine} />}
      </p>
      <dl>
        {about.timeline.map((row) => (
          <div>
            <dt>{row.role}</dt>
            <dd>{row.where}</dd>
            <dd class="when">{row.when}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .head :global(.h2) {
    max-width: 24ch;
  }
  .grid {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .left {
    min-width: 0;
  }
  /* The same dark card in both themes, so the monochrome portrait always has its ground. */
  .photo {
    overflow: hidden;
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-lg);
    background: #111a2e;
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
    filter: grayscale(1) contrast(1.05);
  }
  .id {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }
  .id ul {
    display: flex;
    gap: 1rem;
  }
  .id a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .text {
    font-size: 1.0625rem;
  }
  .agency {
    margin-top: 1.25rem;
    font-family: var(--font-geist);
    font-weight: 500;
  }
  .agency a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  dl {
    margin-top: 1.5rem;
  }
  dl div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.125rem 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--glass-border);
  }
  dt {
    font-family: var(--font-geist);
    font-weight: 500;
  }
  dd {
    color: var(--text-muted);
    font-size: 0.9375rem;
    grid-column: 1;
  }
  .when {
    grid-column: 2;
    grid-row: 1;
    color: var(--text);
    font-family: var(--font-geist-mono);
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(3rem, 5vw, 5rem);
      align-items: start;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import Heading from '../Heading.astro';
import Placeholder from '../Placeholder.astro';
import { getSettings, getToolsStrip, hasPlaceholder, resolveImage } from '../../lib/content';

interface Props {
  about: { heading: string; text: string; photo: { image: string | null; alt: string }; agencyLine: string };
}
const { about } = Astro.props;
const [settings, tools, photo] = await Promise.all([getSettings(), getToolsStrip(), resolveImage(about.photo, 'about photo')]);
const agencyLine = about.agencyLine.replace('[AGENCY NAME]', settings.agencyName);
const agencyLinked = !hasPlaceholder(settings.agencyUrl) && Boolean(settings.agencyUrl);
---

<section class="tools wrap" aria-label="Tools">
  <ul>{tools.map((tool) => <li class="chip">{tool.name}</li>)}</ul>
</section>

<section class="about section wrap" id="about">
  {photo && (
    <div class="photo">
      <Image src={photo.src} alt={photo.alt} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 36vw, 100vw" format="webp" quality={78} />
    </div>
  )}
  <div class="copy">
    <Heading class="h2" text={about.heading} />
    <p class="text">{about.text}</p>
    <p class="agency">
      {agencyLinked ? <a class="text-link" href={settings.agencyUrl}>{agencyLine}</a> : <Placeholder text={agencyLine} />}
    </p>
  </div>
</section>

<style>
  .tools {
    padding-block: 2.5rem;
  }
  .tools ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .about {
    display: grid;
    gap: 2.5rem;
  }
  .photo {
    overflow: hidden;
    aspect-ratio: 4 / 4.4;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .text {
    margin-top: 1.5rem;
    font-size: 1.0625rem;
  }
  .agency {
    margin-top: 1.5rem;
    font-family: var(--font-geist);
    font-weight: 500;
  }
  .agency a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (min-width: 1024px) {
    .about {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
    }
  }
</style>

---
import Markdoc from '@markdoc/markdoc';
import Placeholder from '../Placeholder.astro';
import SectionHead from '../SectionHead.astro';
import VideoPlayer from '../VideoPlayer.astro';
import { getHome, getSettings, hasPlaceholder, resolveImage } from '../../lib/content';

const [{ about }, settings] = await Promise.all([getHome(), getSettings()]);
const dev = import.meta.env.DEV;
const poster = await resolveImage(about.introPoster, 'intro video poster');

const transcriptHtml = Markdoc.renderers.html(Markdoc.transform(about.introTranscript.node));
const transcriptText = transcriptHtml.replace(/<[^>]+>/g, '').trim();
const showTranscript = Boolean(transcriptText) && (dev || !hasPlaceholder(transcriptText));

const socials = [
  { label: 'LinkedIn', href: settings.linkedinUrl },
  { label: 'Upwork', href: settings.upworkUrl },
  { label: 'Fiverr', href: settings.fiverrUrl },
].filter((link) => link.href && (dev || !hasPlaceholder(link.href)));
---

<section class="about wrap section" id="about" aria-labelledby="about-title">
  <SectionHead eyebrow={about.eyebrow} heading={about.heading} faded={about.headingFaded} id="about-title" />

  <div class="grid">
    <div class="media" data-reveal>
      <VideoPlayer videoId={about.introVideoId} poster={poster} duration={about.introDuration} label="Play intro video" title={`Intro video: ${about.name}`} />

      <div class="byline">
        <p><strong>{about.name}</strong><br /><span class="muted">{about.role}</span></p>
        <ul class="socials" aria-label="Profiles">
          {socials.map((link) => (
            <li>{hasPlaceholder(link.href) ? <span class="social"><Placeholder text={link.label + ' ' + link.href} /></span> : <a class="social" href={link.href} rel="me noopener" target="_blank">{link.label}<span class="sr-only"> (opens in a new tab)</span></a>}</li>
          ))}
        </ul>
      </div>

      {showTranscript && (
        <details class="transcript">
          <summary>Read the transcript</summary>
          {hasPlaceholder(transcriptText) ? <p><Placeholder text={transcriptText} /></p> : <div class="transcript-body" set:html={transcriptHtml} />}
        </details>
      )}
    </div>

    <div class="text" data-reveal>
      <p class="bio">{about.bio}</p>
      <dl class="timeline">
        {about.timeline.map((row) => (
          <div class="row">
            <dt>{row.role}</dt>
            <dd class="org">{row.org}</dd>
            <dd class="years">{(dev || !hasPlaceholder(row.years)) && <Placeholder text={row.years} />}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    margin-top: 3.5rem;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.35;
  }
  .byline strong {
    font-weight: 500;
  }
  .muted {
    color: var(--muted);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 44px;
    min-height: 44px;
    padding-inline: 0.875rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--card);
    font-size: 0.875rem;
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    a.social:hover {
      border-color: color-mix(in srgb, var(--ink) 30%, var(--line));
    }
  }

  .transcript {
    margin-top: 0.5rem;
  }
  .transcript summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .transcript p,
  .transcript-body {
    padding-top: 0.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .transcript-body :global(p + p) {
    margin-top: 0.75rem;
  }

  .bio {
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .timeline {
    margin-top: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }
  dt {
    font-weight: 500;
  }
  .org {
    color: var(--muted);
  }
  .years {
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .grid {
      grid-template-columns: 1fr;
      margin-top: 2.5rem;
    }
  }
  @media (max-width: 479px) {
    .row {
      grid-template-columns: 1fr auto;
      row-gap: 0.125rem;
    }
    .org {
      grid-row: 2;
      grid-column: 1 / -1;
    }
    .years {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>


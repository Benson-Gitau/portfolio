---
import Placeholder from '../Placeholder.astro';
import VideoLite from '../VideoLite.astro';
import { getToolsStrip } from '../../lib/content';

interface Props {
  hero: Awaited<ReturnType<typeof import('../../lib/content').getHome>>['hero'];
  cards: { text: string }[];
}
const { hero, cards } = Astro.props;
const tools = await getToolsStrip();
const lines = hero.headlineBefore.split(/(?<=\.)\s+/);
const lastLine = lines.pop();
---

<section class="hero wrap" id="top">
  <p class="badge glass">{hero.eyebrow}</p>
  <h1>
    {lines.map((line) => <span class="line">{line}</span>)}
    <span class="line">{lastLine} <span class="accent-word">{hero.accentWord}</span>{hero.headlineAfter}</span>
  </h1>

  <div class="stage">
    <div class="side left">
      <ul class="notes">
        {cards.map((card, i) => (
          <li class="note glass" style={`--i:${i}`}>
            <span class="mono-label">Demo</span>
            <span><Placeholder text={card.text} /></span>
          </li>
        ))}
      </ul>
      <p class="trust">{hero.trustLine}</p>
    </div>
    <div class="figure">
      <VideoLite video={hero.introVideo} ratio="1 / 1" priority cutout sizes="(min-width: 1024px) 40vw, 100vw" />
    </div>
    <div class="side right">
      <p class="sub">{hero.subline}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#contact" data-book>{hero.primaryCta}</a>
        <a class="btn btn-secondary" href="#work">{hero.secondaryCta}</a>
      </div>
    </div>
  </div>
</section>

<section class="tools wrap" aria-label="Tools">
  <ul>{tools.map((tool) => <li>{tool.name}</li>)}</ul>
</section>

<style>
  .hero {
    display: grid;
    justify-items: center;
    padding-top: clamp(0.5rem, 2vw, 1.5rem);
    text-align: center;
  }
  .badge {
    max-width: 100%;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    box-shadow: none;
    font-size: 0.875rem;
    line-height: 1.3;
  }
  h1 {
    position: relative;
    z-index: 1;
    margin-top: 1.25rem;
    font-size: clamp(2.375rem, 11vw, 5.75rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: initial;
  }
  .line {
    display: block;
    text-wrap: balance;
  }
  h1 .accent-word {
    color: var(--accent-text);
    font-size: 1.22em;
    line-height: 0.8;
  }
  .stage {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    margin-top: 1.25rem;
  }
  /* Phones: headline, actions, video, then the rest. */
  .side {
    display: contents;
  }
  .cta { order: 1; }
  .figure { order: 2; }
  .sub { order: 3; margin-inline: auto; }
  .notes { order: 4; margin-inline: auto; }
  .trust { order: 5; margin-inline: auto; }
  .sub {
    max-width: 44ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .trust {
    max-width: 34ch;
    font-size: 0.875rem;
  }
  .figure {
    min-width: 0;
    width: min(100%, 30rem);
    margin-inline: auto;
  }
  .notes {
    display: grid;
    gap: 0.625rem;
    width: min(100%, 22rem);
  }
  .note {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 1.125rem;
    border-radius: var(--radius-md);
    background: var(--glass-fallback);
    font-family: var(--font-geist);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: left;
    animation: arrive var(--dur-reveal) var(--ease-out) both;
    animation-delay: calc(500ms + var(--i) * 220ms);
  }
  .note .mono-label {
    color: var(--teal-text);
  }
  @keyframes arrive {
    from { opacity: 0; transform: translateY(14px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  .tools {
    padding-block: 1.75rem;
  }
  .tools ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    color: var(--text-muted);
    font-family: var(--font-geist);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  @media (min-width: 1024px) {
    .hero {
      padding-bottom: 0;
    }
    h1 {
      font-size: clamp(3.25rem, 5vw, 6rem);
    }
    .stage {
      /* The figure is sized to the window, so the play button stays on the first screen. */
      grid-template-columns: minmax(0, 1fr) min(36rem, 58svh) minmax(0, 1fr);
      align-items: stretch;
      gap: clamp(1rem, 2vw, 2rem);
      margin-top: -1rem;
    }
    .side {
      display: grid;
      gap: 1.25rem;
      text-align: left;
    }
    .cta, .figure, .sub, .notes, .trust {
      order: 0;
      margin-inline: 0;
    }
    .left {
      justify-items: start;
      align-content: space-between;
      padding-top: 2.5rem;
      padding-bottom: 1rem;
    }
    .right {
      justify-items: end;
      align-content: end;
      padding-bottom: 1rem;
    }
    .notes {
      width: min(100%, 17rem);
    }
    .note:nth-child(1) { rotate: -2deg; }
    .note:nth-child(2) { rotate: 1.5deg; margin-left: 1.25rem; }
    .note:nth-child(3) { rotate: -1deg; }
    .sub {
      max-width: 32ch;
    }
    .cta {
      justify-content: flex-start;
      width: min(100%, 32ch);
    }
    .figure {
      width: 100%;
    }
  }
</style>

---
import Placeholder from '../Placeholder.astro';
import Tick from '../Tick.astro';
import VideoLite from '../VideoLite.astro';

interface Props {
  hero: Awaited<ReturnType<typeof import('../../lib/content').getHome>>['hero'];
  cards: { text: string }[];
}
const { hero, cards } = Astro.props;
const lines = hero.headlineBefore.split(/(?<=\.)\s+/);
const lastLine = lines.pop();
---

<section class="hero wrap" id="top">
  <div class="copy">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1>
      {lines.map((line) => (
        <span class="row"><span>{line}</span><Tick class="tick" /></span>
      ))}
      <span class="row"><span>{lastLine} <span class="accent-word">{hero.accentWord}</span>{hero.headlineAfter}</span><Tick class="tick" /></span>
    </h1>
    <p class="sub">{hero.subline}</p>
    <div class="cta">
      <a class="btn btn-primary" href="#contact" data-book>{hero.primaryCta}</a>
      <a class="btn btn-secondary" href="#work">{hero.secondaryCta}</a>
    </div>
    <p class="trust">{hero.trustLine}</p>
  </div>
  <div class="video">
    <VideoLite video={hero.introVideo} ratio="4 / 4.2" priority sizes="(min-width: 1024px) 36vw, 100vw" />
    <ul class="notes">
      {cards.map((card, i) => (
        <li class="note glass" style={`--i:${i}`}><span class="mono-label">Demo</span><span><Placeholder text={card.text} /></span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 1.25rem;
    padding-top: 0.5rem;
    padding-bottom: 2rem;
  }
  /* Phones: headline, action, then the video, all on the first screen. */
  .copy {
    display: contents;
  }
  .eyebrow { order: 1; }
  h1 { order: 2; }
  .cta { order: 3; }
  .video { order: 4; }
  .sub { order: 5; }
  .trust { order: 6; }
  .eyebrow {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin-bottom: -0.5rem;
  }
  h1 {
    display: block;
    font-size: clamp(2rem, 9.2vw, 5.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: initial;
  }
  /* Each sentence of the headline is a ledger row, ruled and ticked off. */
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.16em;
    border-bottom: 1px solid var(--rule);
  }
  .row > span:first-child {
    text-wrap: balance;
  }
  .row:first-child {
    border-top: 1px solid var(--rule);
  }
  h1 .accent-word {
    color: var(--accent-text);
    font-size: 1.08em;
    line-height: 0.9;
  }
  .row :global(.tick) {
    width: 0.55em;
    height: 0.55em;
    color: var(--teal-text);
  }
  .row :global(.tick path) {
    stroke-dasharray: 1;
    animation: draw var(--dur-reveal) var(--ease-out) both;
  }
  .row:nth-child(1) :global(.tick path) { animation-delay: 300ms; }
  .row:nth-child(2) :global(.tick path) { animation-delay: 560ms; }
  .row:nth-child(3) :global(.tick path) { animation-delay: 820ms; }
  @keyframes draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .sub {
    max-width: 60ch;
  }
  .trust {
    color: var(--text-muted);
    font-size: 0.875rem;
    max-width: none;
  }
  .video {
    position: relative;
    min-width: 0;
  }
  .notes {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .note {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-family: var(--font-geist);
    font-weight: 500;
    line-height: 1.3;
    /* Near-solid: these sit over the photo and must hold AA on any part of it. */
    background: color-mix(in srgb, var(--glass-fallback) 94%, transparent);
    animation: arrive var(--dur-reveal) var(--ease-out) both;
    animation-delay: calc(900ms + var(--i) * 260ms);
  }
  .note .mono-label {
    color: var(--teal-text);
  }
  @keyframes arrive {
    from { opacity: 0; transform: translateY(16px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: clamp(2rem, 4vw, 4rem);
      padding-top: 1rem;
    }
    .copy { display: block; }
    h1 { font-size: clamp(3rem, 4.75vw, 5.5rem); }
    .eyebrow { margin-bottom: 1rem; }
    .sub { margin-top: 1.25rem; }
    .cta { margin-top: 1.5rem; }
    .trust { margin-top: 1.25rem; }
  }
  /* Cards float beside the face only where there is room to clear it. */
  @media (min-width: 1280px) {
    .notes {
      position: absolute;
      left: -2.5rem;
      top: 2.5rem;
      width: 10.5rem;
      margin: 0;
    }
    .note {
      padding: 0.625rem 0.75rem;
      font-size: 0.9375rem;
    }
  }
  @media (min-width: 1440px) {
    .notes {
      top: 3rem;
      width: 12rem;
    }
    .note {
      padding: 0.75rem 1rem;
      font-size: 1rem;
    }
  }
</style>

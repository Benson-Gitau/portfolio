---
import { Image } from 'astro:assets';
import Placeholder from '../Placeholder.astro';
import { getHome, introVideoReady, resolveImage } from '../../lib/content';

const home = await getHome();
const { hero } = home;
const portrait = await resolveImage(hero.heroPortrait, 'hero portrait');
// The intro lives in About. In development an unfinished video still shows its button.
const showIntro = introVideoReady(home.about.introVideoId) || import.meta.env.DEV;
---

<section class="hero wrap" id="top" aria-labelledby="hero-title">
  <h1 class="title" id="hero-title">
    <span class="l1">{hero.greeting}</span>
    <span class="l2 serif">{hero.title}</span>
  </h1>

  <div class="row">
    <div class="side left">
      <p class="pill available"><span class="status-dot" aria-hidden="true"></span>{hero.available}</p>
      <p class="audience">{hero.audience}</p>
    </div>

    <div class="portrait">
      {portrait ? (
        <Image
          src={portrait.src}
          alt={portrait.alt}
          widths={[320, 420, 640, 840]}
          sizes="(min-width: 760px) 420px, 280px"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="portrait-missing mono-label"><Placeholder text="[HERO_PORTRAIT]" /></div>
      )}
    </div>

    <div class="side right">
      <p class="statement">{hero.statement}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#book" data-book>{hero.primaryCta}</a>
        {showIntro && (
          <a class="btn btn-secondary" href="#about">
            <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M4 2.6v10.8a.8.8 0 0 0 1.2.7l8.6-5.4a.8.8 0 0 0 0-1.4L5.2 1.9A.8.8 0 0 0 4 2.6Z"></path></svg>
            {hero.introCta}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
    text-align: center;
  }

  .title {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    font-weight: 400;
    text-wrap: balance;
  }
  .l1 {
    font-size: clamp(2.75rem, 6vw, 5.25rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .l2 {
    font-size: clamp(3.5rem, 9vw, 8.25rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr minmax(0, 420px) 1fr;
    align-items: end;
    gap: 2rem;
  }

  .side {
    display: flex;
    flex-direction: column;
    padding-bottom: 2.5rem;
    text-align: left;
  }
  .left {
    align-items: flex-start;
  }
  .right {
    align-items: flex-start;
    justify-self: end;
  }
  .right .statement {
    max-width: 300px;
  }

  .available {
    font-size: 0.9375rem;
  }
  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status);
  }
  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--status);
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes pulse {
    from {
      opacity: 0.55;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  .audience {
    max-width: 22ch;
    margin-top: 7.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .statement {
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .portrait {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 420px;
    margin-top: clamp(-5rem, -5vw, -2.5rem);
    aspect-ratio: 4 / 5;
    animation: portrait-in 900ms var(--ease-out) both;
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }
  .portrait-missing {
    display: grid;
    place-items: center;
    height: 100%;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: var(--soft);
  }
  @keyframes portrait-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @media (max-width: 959px) {
    .row {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0;
    }
    .left {
      display: contents;
    }
    .portrait {
      grid-row: 1;
      grid-column: 1;
      width: 280px;
      margin-top: 1rem;
    }
    /* The pill floats over the portrait's left edge. */
    .available {
      grid-row: 1;
      grid-column: 1;
      z-index: 2;
      justify-self: start;
      align-self: end;
      margin-bottom: 22%;
      margin-left: max(0px, calc(50% - 172px));
      font-size: 0.875rem;
    }
    .right {
      justify-self: stretch;
      max-width: 34rem;
      margin-inline: auto;
      padding: 2rem 0 0;
      text-align: center;
      align-items: stretch;
    }
    .statement {
      margin-inline: auto;
    }
    .actions {
      flex-direction: column;
    }
    .actions .btn {
      width: 100%;
    }
    .audience {
      grid-row: 3;
      max-width: none;
      margin: 1.5rem 0 2rem;
      text-align: center;
    }
  }
</style>

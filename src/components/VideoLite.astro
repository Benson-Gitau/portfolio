---
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import { hasPlaceholder, resolveImage, videoReady } from '../lib/content';

interface Props {
  video: {
    youtubeId: string;
    title: string;
    poster: { image: string | null; alt: string };
    transcript: string;
    durationLabel: string;
  };
  ratio?: string;
  position?: string;
  priority?: boolean;
  sizes?: string;
  /** The page already shows the title beside the player. */
  titleOutside?: boolean;
  /** Poster is a transparent cut-out with no frame around it. */
  cutout?: boolean;
}
const { video, ratio = '16 / 9', position = '50% 22%', priority = false, sizes = '(min-width: 1024px) 40vw, 100vw', titleOutside = false, cutout = false } = Astro.props;
const poster = await resolveImage(video.poster, `${video.title} poster`);
const ready = videoReady(video);
// In development unfinished values stay visible and marked. On the live site they are left out.
const showPlayer = ready || import.meta.env.DEV;
const showTranscript = Boolean(video.transcript) && (import.meta.env.DEV || !hasPlaceholder(video.transcript));
const src = ready
  ? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(video.youtubeId)}?autoplay=1&cc_load_policy=1&rel=0&playsinline=1`
  : '';
---

<figure class:list={['video-lite', { cutout }]} data-video-lite data-src={src} data-title={video.title}>
  <div class:list={['frame', { glass: !cutout }]}>
    <div class="poster" data-poster style={`aspect-ratio:${ratio}`}>
      {poster ? (
        <Image src={poster.src} alt={poster.alt} widths={[480, 800, 1200]} sizes={sizes} format="webp" quality={78} style={`object-position:${position}`} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
      ) : (
        !titleOutside && <p class="no-poster">{video.title}</p>
      )}
      {showPlayer && <button type="button" class="play" aria-label={`Play video: ${video.title}`}>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.53.85l10.5-6.5a1 1 0 0 0 0-1.7L9.53 4.65A1 1 0 0 0 8 5.5Z"></path></svg>
      </button>}
      {showPlayer && video.durationLabel && <span class="dur">{video.durationLabel}</span>}
    </div>
  </div>
  {import.meta.env.DEV && !ready && <p class="status"><Placeholder text={video.youtubeId} /></p>}
  <p class="status" data-status role="status"></p>
  {showTranscript && (
    <details class="transcript">
      <summary>Read transcript</summary>
      <p><Placeholder text={video.transcript} /></p>
    </details>
  )}
</figure>

<style>
  .video-lite {
    margin: 0;
    min-width: 0;
  }
  .frame {
    padding: 0.5rem;
    border-radius: var(--radius-lg);
  }
  .poster {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .poster :global(img),
  .poster :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .poster :global(img) {
      transition: transform 600ms var(--ease-out);
    }
    .poster:hover :global(img) {
      transform: scale(1.03);
    }
  }
  .no-poster {
    max-width: 30ch;
    padding: 1.25rem;
    font-family: var(--font-geist);
    font-size: clamp(1.125rem, 2.4vw, 1.75rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .play {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    cursor: pointer;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.3);
    transition: transform var(--dur-micro) var(--ease-out);
  }
  .play:active {
    transform: scale(0.95);
  }
  .dur {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    background: #0b1220;
    color: #f5f7fa;
    font-family: var(--font-geist-mono);
    font-size: 0.8125rem;
  }
  /* Hero: the figure stands on the page. Its frame returns only once a video is playing. */
  .cutout .frame {
    padding: 0;
  }
  .cutout .poster {
    background: transparent;
  }
  .cutout .poster :global(img) {
    object-fit: contain;
    object-position: 50% 100%;
    filter: grayscale(1) contrast(1.05);
    transform: none !important;
  }
  .cutout .poster:has(iframe) {
    background: #0b1220;
  }
  .cutout .play {
    left: 50%;
    bottom: 12%;
    translate: -50% 0;
  }
  .cutout .dur {
    right: auto;
    left: calc(50% + 2.75rem);
    bottom: calc(12% + 1.25rem);
  }
  .cutout .transcript,
  .cutout .status {
    text-align: center;
  }
  .status:empty {
    display: none;
  }
  .status {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  .transcript summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .transcript p {
    padding: 0.5rem;
    color: var(--text);
    font-size: 0.9375rem;
  }
</style>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-video-lite] .play');
    if (!button) return;
    const root = button.closest<HTMLElement>('[data-video-lite]')!;
    const src = root.dataset.src;
    if (!src) {
      root.querySelector('[data-status]')!.textContent = 'This video is not available yet.';
      return;
    }
    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = root.dataset.title ?? 'Video';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    const poster = root.querySelector<HTMLElement>('[data-poster]')!;
    poster.replaceChildren(iframe);
    iframe.focus();
  });
</script>

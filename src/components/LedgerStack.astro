---
// Decorative 3D accent. The drawing is the fallback for phones, low-power devices,
// reduced motion and failed WebGL; the canvas fades in over it without moving anything.
const sheets = [60, 48, 36, 24, 12, 0];
const rhombus = (y: number) => `20,${y + 62} 160,${y + 8} 300,${y + 62} 160,${y + 116}`;
---

<div class="stack" data-ledger-stack aria-hidden="true">
  <svg viewBox="0 0 320 190" fill="none">
    {sheets.map((y) => <polygon points={rhombus(y)} fill="var(--surface)" stroke="var(--line-strong)" stroke-width="1.5" stroke-linejoin="round"></polygon>)}
    <g stroke="var(--text-muted)" stroke-opacity="0.45" stroke-width="1.5">
      <path d="M72 62 188 18M100 72 216 28M128 83 244 39M156 94 272 50"></path>
    </g>
    <path d="M201 74 208 81 222 66" stroke="var(--teal-text)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</div>

<style>
  .stack {
    position: relative;
    width: 100%;
    max-width: 16rem;
    aspect-ratio: 4 / 3;
    margin-top: 2rem;
    pointer-events: none;
  }
  svg,
  .stack :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  svg {
    transition: opacity var(--dur-ui) var(--ease-out);
  }
  .stack :global(canvas) {
    opacity: 0;
    transition: opacity var(--dur-reveal) var(--ease-out);
  }
  .stack[data-live] svg {
    opacity: 0;
  }
  .stack[data-live] :global(canvas) {
    opacity: 1;
  }
  @media (min-width: 1024px) {
    .stack {
      max-width: 24rem;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ledger-stack]');
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const memory = (navigator as Navigator & { deviceMemory?: number }).deviceMemory;
  const lowPower = navigator.hardwareConcurrency <= 4 || (memory !== undefined && memory <= 4) || connection?.saveData === true;
  const allowed = window.matchMedia('(min-width: 768px) and (prefers-reduced-motion: no-preference)').matches && !lowPower;

  if (root && allowed) {
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        // Any failure simply leaves the drawing in place.
        import('../lib/ledger-stack').then(({ mount }) => mount(root)).catch(() => {});
      },
      { rootMargin: '200px' },
    ).observe(root);
  }
</script>

---
import { getFeaturedTestimonials } from '../lib/content';

interface Props {
  /** Landing pages: logo and Book a call only. */
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
const hasReviews = (await getFeaturedTestimonials()).length > 0;

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#services', label: 'Services' },
  { href: '/#process', label: 'Process' },
  ...(hasReviews ? [{ href: '/#reviews', label: 'Reviews' }] : []),
  { href: '/#about', label: 'About' },
];
const bookHref = minimal ? '#contact' : '/#book';
---

<header class="site-header wrap" data-nav>
  <a class="brand serif" href="/">Benson Gitau</a>
  {!minimal && (
    <nav aria-label="Main" class="links">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  )}
  <div class="end">
    <a class:list={['btn btn-primary btn-sm book', { always: minimal }]} href={bookHref} data-book>Book a call</a>
    {!minimal && (
      <button type="button" class="menu" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16M4 15h16"></path></svg>
      </button>
    )}
  </div>
  {!minimal && (
    <nav id="mobile-menu" class="sheet" aria-label="Menu" data-menu hidden>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="btn btn-primary" href={bookHref} data-book>Book a call</a>
    </nav>
  )}
</header>

<style>
  .site-header {
    position: relative;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 1.25rem;
  }
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 1.625rem;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
  }
  .links {
    display: none;
    gap: 0.25rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.875rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-geist);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color var(--dur-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .links a:hover {
      background: color-mix(in srgb, var(--card) 60%, transparent);
    }
  }
  .end {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .book {
    display: none;
  }
  .book.always {
    display: inline-flex;
  }
  .menu {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
  }
  .sheet {
    position: absolute;
    top: calc(100% - 0.25rem);
    right: var(--gutter);
    left: var(--gutter);
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--card);
    box-shadow: var(--shadow-soft);
    transform-origin: top right;
    animation: sheet-in var(--dur-ui) var(--ease-out);
  }
  .sheet[hidden] {
    display: none;
  }
  .sheet a:not(.btn) {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-inline: 0.5rem;
    font-family: var(--font-geist);
    text-decoration: none;
  }
  .sheet .btn {
    margin-top: 0.5rem;
  }
  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(-4px);
    }
  }
  @media (min-width: 860px) {
    .links {
      display: flex;
    }
    .book {
      display: inline-flex;
    }
    .menu,
    .sheet {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  function setMenu(open: boolean) {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  toggle?.addEventListener('click', () => setMenu(menu?.hidden ?? false));
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) {
      setMenu(false);
      toggle?.focus();
    }
  });
</script>

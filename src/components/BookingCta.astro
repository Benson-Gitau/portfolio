---
// Closing call to action with the calendar inline (med spa page). Sits on the bottom wash.
import BookingEmbed from './BookingEmbed.astro';
import { getSettings } from '../lib/content';

interface Props {
  cta: { heading: string; text: string };
  /** Replaces the email and LinkedIn links below the calendar. */
  note?: string;
}
const { cta, note } = Astro.props;
const settings = await getSettings();
---

<section class="final wrap" id="contact" aria-labelledby="contact-title">
  <h2 id="contact-title" data-reveal>{cta.heading}</h2>
  <p class="text" data-reveal>{cta.text}</p>
  <div class="calendar"><BookingEmbed loadOn="view" /></div>
  {note ? (
    <p class="note">{note}</p>
  ) : (
    <ul class="links">
      <li><a class="text-link" href={`mailto:${settings.email}`}>{settings.email}</a></li>
      <li><a class="text-link" href={settings.linkedinUrl}>LinkedIn</a></li>
    </ul>
  )}
</section>

<style>
  .final {
    display: grid;
    justify-items: center;
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    text-align: center;
  }
  h2 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 5.5vw, 4.75rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .text {
    max-width: 44ch;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .calendar {
    width: min(100%, 52rem);
    min-width: 0;
    margin-top: 2.5rem;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-soft);
    text-align: left;
  }
  .note {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 1.25rem;
    margin-top: 1rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    overflow-wrap: anywhere;
  }
</style>

---
import { getFeaturedTestimonials, getSettings } from '../lib/content';

interface Props {
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
const [settings, reviews] = await Promise.all([getSettings(), getFeaturedTestimonials()]);
const year = new Date().getFullYear();

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#services', label: 'Services' },
  ...(reviews.length ? [{ href: '/#reviews', label: 'Reviews' }] : []),
  { href: '/#about', label: 'About' },
  { href: '/med-spas', label: 'For med spas' },
  { href: `mailto:${settings.email}`, label: 'Contact' },
];
---

<footer class="footer">
  <div class="top wrap">
    {!minimal && (
      <nav aria-label="Footer">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    )}
    <p class="copy">© {year} Benson Gitau</p>
  </div>
  <div class="name-crop" aria-hidden="true">
    <p class="name serif">Benson Gitau</p>
  </div>
</footer>

<style>
  .footer {
    overflow: hidden;
    font-size: 0.9375rem;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.5rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      text-decoration: underline;
    }
  }
  .copy {
    color: var(--muted);
  }
  /* The name runs off the bottom of the page. */
  .name-crop {
    --size: clamp(90px, 17vw, 260px);
    height: calc(var(--size) * 0.62);
    margin-top: clamp(1rem, 3vw, 2.5rem);
    overflow: hidden;
  }
  .name {
    max-width: none;
    font-size: var(--size);
    line-height: 0.78;
    letter-spacing: -0.02em;
    text-align: center;
    white-space: nowrap;
  }
  /* Below ~530px the 90px floor would cut "Gitau" off the side; the name scales with the
     screen instead, so only the bottom edge crops it. */
  @media (max-width: 529px) {
    .name-crop {
      --size: 17vw;
    }
  }
  @media (max-width: 759px) {
    .top {
      flex-direction: column;
      align-items: flex-start;
    }
    nav {
      column-gap: 1.125rem;
    }
  }
</style>

---
import Placeholder from './Placeholder.astro';
import { getSettings, hasPlaceholder } from '../lib/content';

interface Props {
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
const settings = await getSettings();
const agencyLinked = !hasPlaceholder(settings.agencyUrl) && Boolean(settings.agencyUrl);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="top wrap">
    {!minimal && <nav aria-label="Footer">
      <a href="/#work">Work</a>
      <a href="/#services">Services</a>
      {agencyLinked ? <a href={settings.agencyUrl}>{settings.agencyName}</a> : <span><Placeholder text={settings.agencyName} /></span>}
      <a href={settings.linkedinUrl}>LinkedIn</a>
      <a href={settings.githubUrl}>GitHub</a>
      <a href={settings.xUrl}>X</a>
    </nav>}
    <p class="meta">{settings.footerRole}<br />{settings.footerLocation}<br />© {year}</p>
  </div>
  <p class="wordmark">Benson Gitau</p>
</footer>

<style>
  .footer {
    overflow: hidden;
    padding-top: 2rem;
    font-size: 0.9375rem;
  }
  .top {
    display: grid;
    gap: 1.25rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.25rem;
  }
  nav a,
  nav span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .meta {
    color: var(--text-muted);
  }
  .wordmark {
    max-width: none;
    margin-top: 1.5rem;
    font-family: var(--font-instrument);
    font-size: 21.5vw;
    font-style: italic;
    line-height: 0.82;
    letter-spacing: -0.03em;
    text-align: center;
    white-space: nowrap;
    padding-bottom: 0.08em;
  }
  @media (min-width: 768px) {
    .top {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
    .meta {
      text-align: right;
    }
  }
</style>

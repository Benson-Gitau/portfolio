---
// Client projects only. The content module empties these for demos as well.
import Tick from '../Tick.astro';

interface Props {
  heading: string;
  results: readonly { value: string; label: string }[];
  note: string;
}
const { heading, results, note } = Astro.props;
---

{(results.length > 0 || note) && (
  <section class="results">
    <div class="section wrap">
      <h2 class="h2">{heading}</h2>
      <dl>
        {results.map((result) => (
          <div class="row">
            <dt>{result.label}</dt>
            <dd class="value">{result.value}</dd>
          </div>
        ))}
      </dl>
      {note && <p class="note"><Tick class="t" />{note}</p>}
    </div>
  </section>
)}

<style>
  .results > :global(.section) {
    padding-top: 0;
  }
  .results :global(.h2) {
    text-align: center;
  }
  dl {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .row {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .value {
    order: -1;
    color: var(--accent-text);
    font-family: var(--font-geist-mono);
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  dt {
    font-family: var(--font-geist);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 500;
    line-height: 1.25;
  }
  .note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 1.5rem auto 0;
    font-family: var(--font-geist);
    font-size: 1.125rem;
    font-weight: 500;
  }
  .note :global(.t) {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--teal-text);
  }
  @media (min-width: 768px) {
    dl {
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    }
  }
</style>

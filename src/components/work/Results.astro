---
// Client projects only. The content module empties these for demos as well.
import Tick from '../Tick.astro';

interface Props {
  heading: string;
  results: readonly { value: string; label: string }[];
  note: string;
}
const { heading, results, note } = Astro.props;
---

{(results.length > 0 || note) && (
  <section class="results">
    <div class="section wrap">
      <h2 class="h2">{heading}</h2>
      <dl>
        {results.map((result) => (
          <div class="row">
            <dt>{result.label}</dt>
            <dd class="value">{result.value}</dd>
          </div>
        ))}
      </dl>
      {note && <p class="note"><Tick class="t" />{note}</p>}
    </div>
  </section>
)}

<style>
  .results {
    background: var(--surface);
  }
  dl {
    margin-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }
  .row {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .value {
    order: -1;
    color: var(--accent-text);
    font-family: var(--font-geist-mono);
    font-size: clamp(3rem, 8vw, 7.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  dt {
    font-family: var(--font-geist);
    font-size: clamp(1.125rem, 2vw, 1.625rem);
    font-weight: 500;
    line-height: 1.25;
  }
  .note {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-family: var(--font-geist);
    font-size: 1.125rem;
    font-weight: 500;
  }
  .note :global(.t) {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--teal-text);
  }
  @media (min-width: 768px) {
    .row {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: 2rem;
    }
  }
</style>

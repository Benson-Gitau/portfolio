---
// A real ordered list. Text is never hidden: only the ticks draw, one step at a time.
import Placeholder from '../Placeholder.astro';
import Tick from '../Tick.astro';

interface Props {
  steps: readonly { title: string; description: string }[];
}
const { steps } = Astro.props;
---

<ol class="diagram" data-diagram>
  {steps.map((step, i) => (
    <li style={`--i:${i}`}>
      <span class="num" aria-hidden="true">{i + 1}</span>
      <div class="text">
        <p class="title"><Placeholder text={step.title} /></p>
        {step.description && <p class="desc"><Placeholder text={step.description} /></p>}
      </div>
      <Tick class="tick" />
    </li>
  ))}
</ol>

<style>
.diagram {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }
  li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .num {
    color: var(--text-muted);
    font-family: var(--font-geist-mono);
    font-size: 0.9375rem;
  }
  .title {
    max-width: none;
    font-family: var(--font-geist);
    font-size: clamp(1.125rem, 2vw, 1.625rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .desc {
    margin-top: 0.25rem;
    color: var(--text-muted);
  }
  li :global(.tick) {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--teal-text);
  }
  li :global(.tick path) {
    stroke-dasharray: 1;
  }
  .diagram[data-armed] :global(.tick path) {
    stroke-dashoffset: 1;
  }
  .diagram[data-playing] :global(.tick path) {
    animation: draw var(--dur-reveal) var(--ease-out) both;
    animation-delay: calc(var(--i) * 160ms);
  }
  @keyframes draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
</style>

<script>
  // Armed only when motion is allowed; otherwise, or without JavaScript, every tick is simply there.
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('[data-diagram]').forEach((diagram) => {
      diagram.toggleAttribute('data-armed', true);
      new IntersectionObserver(
        ([entry], observer) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          diagram.toggleAttribute('data-playing', true);
        },
        { threshold: 0.25 },
      ).observe(diagram);
    });
  }
</script>

---
import About from '../components/home/About.astro';
import FinalCta from '../components/home/FinalCta.astro';
import Hero from '../components/home/Hero.astro';
import Jambo from '../components/home/Jambo.astro';
import Process from '../components/home/Process.astro';
import Services from '../components/home/Services.astro';
import ProjectPanel from '../components/home/ProjectPanel.astro';
import ToolRow from '../components/home/ToolRow.astro';
import WorkGrid from '../components/home/WorkGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getFeaturedTestimonials, getHome, getSettings, hasPlaceholder } from '../lib/content';

const [home, testimonials, settings] = await Promise.all([getHome(), getFeaturedTestimonials(), getSettings()]);

const person = {
  '@type': 'Person',
  name: 'Benson Gitau',
  jobTitle: home.hero.title,
  sameAs: [settings.linkedinUrl, settings.upworkUrl, settings.fiverrUrl, settings.githubUrl].filter((url) => url && !hasPlaceholder(url)),
  ...(Astro.site ? { url: Astro.site.href } : {}),
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    ...home.services.items.map((service) => ({
      '@type': 'Service',
      name: service.title,
      description: service.text,
      provider: { '@type': 'Person', name: person.name },
    })),
  ],
};
---

<SiteLayout title={home.seo.title} description={home.seo.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />
  <Hero />
  <ToolRow />
  <ProjectPanel />
  <Jambo />
  <Process />
  <WorkGrid />
  <Services />
  <Testimonials eyebrow={home.reviews.eyebrow} heading={home.reviews.heading} items={testimonials} />
  <About />
  <FinalCta />
</SiteLayout>

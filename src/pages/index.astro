---
import About from '../components/home/About.astro';
import FinalCta from '../components/home/FinalCta.astro';
import Hero from '../components/home/Hero.astro';
import Leaks from '../components/home/Leaks.astro';
import Process from '../components/home/Process.astro';
import Services from '../components/home/Services.astro';
import WorkGrid from '../components/home/WorkGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getFeaturedTestimonials, getHome } from '../lib/content';

const [home, testimonials] = await Promise.all([getHome(), getFeaturedTestimonials()]);
---

<SiteLayout title={home.seo.title} description={home.seo.description}>
  <Hero hero={home.hero} cards={home.heroCards} />
  <Leaks problem={home.problem} outcomes={home.outcomes} />
  <WorkGrid work={home.work} />
  <Services services={home.services} />
  <Process process={home.process} />
  <About about={home.about} />
  <Testimonials heading={home.proof.heading} items={testimonials} />
  <FinalCta cta={home.finalCta} />
</SiteLayout>

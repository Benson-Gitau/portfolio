---
import About from '../components/home/About.astro';
import FinalCta from '../components/home/FinalCta.astro';
import Hero from '../components/home/Hero.astro';
import Leaks from '../components/home/Leaks.astro';
import Process from '../components/home/Process.astro';
import Services from '../components/home/Services.astro';
import WorkGrid from '../components/home/WorkGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getFeaturedTestimonials, getHome, getSettings, hasPlaceholder } from '../lib/content';

const [home, testimonials, settings] = await Promise.all([getHome(), getFeaturedTestimonials(), getSettings()]);

const person = {
  '@type': 'Person',
  name: 'Benson Gitau',
  jobTitle: 'Automation & AI Systems Consultant',
  sameAs: [settings.linkedinUrl, settings.githubUrl, settings.xUrl],
  ...(hasPlaceholder(settings.siteUrl) ? {} : { url: settings.siteUrl }),
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    ...home.services.items.map((service) => ({
      '@type': 'Service',
      name: service.title,
      description: service.text,
      provider: { '@type': 'Person', name: person.name },
    })),
  ],
};
---

<SiteLayout title={home.seo.title} description={home.seo.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />
  <Hero hero={home.hero} cards={home.heroCards} />
  <Leaks problem={home.problem} outcomes={home.outcomes} />
  <WorkGrid work={home.work} />
  <Services services={home.services} />
  <Process process={home.process} />
  <About about={home.about} />
  <Testimonials heading={home.proof.heading} items={testimonials} />
  <FinalCta cta={home.finalCta} />
</SiteLayout>

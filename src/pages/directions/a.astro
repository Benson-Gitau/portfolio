---
// Direction A, The Reconciliation. Phase 2 prototype; removed once a direction is chosen.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProtoNav from '../../components/proto/ProtoNav.astro';
import VideoFrame from '../../components/proto/VideoFrame.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getHome } from '../../lib/content';

const { hero, heroCards } = await getHome();
const lines = hero.headlineBefore.split(/(?<=\.)\s+/);
const lastLine = lines.pop();

const tick = '<svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path pathLength="1" d="M4 13l5 5L20 6"/></svg>';
---

<BaseLayout title="Direction A: The Reconciliation" noindex>
  <div class="page" id="top">
    <ProtoNav />
    <main id="main" class="hero">
      <div class="copy">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>
          {lines.map((line) => (
            <span class="row"><span class="words">{line}</span><span class="tick" set:html={tick}></span></span>
          ))}
          <span class="row"><span class="words">{lastLine} <span class="accent-word">{hero.accentWord}</span>{hero.headlineAfter}</span><span class="tick" set:html={tick}></span></span>
        </h1>
        <p class="sub">{hero.subline}</p>
        <div class="cta">
          <button type="button" class="primary">{hero.primaryCta}</button>
          <a class="secondary" href="#work">{hero.secondaryCta}</a>
        </div>
      </div>
      <div class="video">
        <VideoFrame ratio="4 / 4.2" />
        <ul class="notes">
          {heroCards.map((card, i) => (
            <li class="note glass" style={`--i:${i}`}><span class="demo">Demo</span><span><Placeholder text={card.text} /></span></li>
          ))}
        </ul>
      </div>
      <p class="trust">{hero.trustLine}</p>
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100dvh;
    background: radial-gradient(60rem 40rem at 0% 0%, var(--glow-a), transparent 70%), radial-gradient(60rem 40rem at 100% 100%, var(--glow-b), transparent 70%), var(--bg);
    overflow: hidden;
  }
  .hero {
    display: grid;
    gap: 1.5rem;
    padding: 1rem 1rem 2rem;
    max-width: 96rem;
    margin-inline: auto;
  }
  /* Phones: headline, action, then the video, all on the first screen. */
  .copy { display: contents; }
  .eyebrow { order: 1; }
  h1 { order: 2; }
  .cta { order: 3; }
  .video { order: 4; }
  .sub { order: 5; }
  .trust { order: 7; }
  .eyebrow {
    color: var(--text-muted);
    margin-bottom: -0.75rem;
    font-size: 0.9375rem;
  }
  h1 {
    display: block;
    font-size: clamp(2rem, 9.2vw, 5.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: initial;
  }
  /* Each sentence of the headline is a ledger row, ruled and ticked off. */
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.16em;
    border-bottom: 1px solid color-mix(in srgb, var(--text) 26%, transparent);
  }
  .row:first-child {
    border-top: 1px solid color-mix(in srgb, var(--text) 26%, transparent);
  }
  .accent-word {
    color: var(--accent-text);
    font-size: 1.08em;
    line-height: 0.9;
  }
  .tick {
    flex: none;
    width: 0.55em;
    height: 0.55em;
    color: var(--teal-text);
  }
  .tick :global(path) {
    stroke-dasharray: 1;
    animation: draw var(--dur-reveal) var(--ease-out) both;
  }
  .row:nth-child(1) .tick :global(path) { animation-delay: 300ms; }
  .row:nth-child(2) .tick :global(path) { animation-delay: 560ms; }
  .row:nth-child(3) .tick :global(path) { animation-delay: 820ms; }
  @keyframes draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  .sub { max-width: 60ch; }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .primary {
    min-height: 3.25rem;
    padding-inline: 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-geist);
    font-weight: 600;
    cursor: pointer;
    transition: transform var(--dur-micro) var(--ease-out);
  }
  .primary:active { transform: scale(0.97); }
  .secondary {
    display: inline-flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--text) 45%, var(--bg));
    background: var(--surface);
    font-family: var(--font-geist);
    font-weight: 500;
  }
  .video { position: relative; min-width: 0; }
  .notes { display: grid; gap: 0.5rem; margin-top: 0.25rem; }
  .note {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-family: var(--font-geist);
    font-weight: 500;
    line-height: 1.3;
    /* Near-solid: these sit over the photo and must hold AA on any part of it. */
    background: color-mix(in srgb, var(--glass-fallback) 94%, transparent);
    animation: arrive var(--dur-reveal) var(--ease-out) both;
    animation-delay: calc(900ms + var(--i) * 260ms);
  }
  @keyframes arrive {
    from { opacity: 0; transform: translateY(16px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  .demo {
    font-family: var(--font-geist-mono);
    font-size: 0.8125rem;
    color: var(--teal-text);
    font-weight: 500;
  }
  .trust {
    color: var(--text-muted);
    font-size: 0.875rem;
    max-width: none;
  }
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: clamp(2rem, 4vw, 4rem);
      row-gap: 1.25rem;
      padding: 1.25rem 2rem 1.5rem;
    }
    h1 { font-size: clamp(3rem, 4.75vw, 5.5rem); }
    .copy { display: block; }
    .video { grid-row: 1; grid-column: 2; }
    .trust { grid-column: 1 / -1; }
    .eyebrow { margin-bottom: 1rem; }
    .sub { margin-top: 1.25rem; }
    .cta { margin-top: 1.5rem; }
  }
  /* Cards float beside the face only where there is room to clear it. */
  @media (min-width: 1280px) {
    .notes {
      position: absolute;
      left: -2.75rem;
      bottom: 9rem;
      width: 12.75rem;
      margin: 0;
    }
  }
</style>

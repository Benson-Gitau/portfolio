---
import { Image } from 'astro:assets';
import BookingCta from '../components/BookingCta.astro';
import Placeholder from '../components/Placeholder.astro';
import Testimonials from '../components/Testimonials.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getHome, getMedSpaPage, getProjects, getProjectTestimonials, hasPlaceholder, resolveImage, videoReady } from '../lib/content';

const [page, home, projects] = await Promise.all([getMedSpaPage(), getHome(), getProjects()]);
const project = projects.find((item) => item.slug === page.proof.project);
if (!project) throw new Error('[content] medSpaPage proof must link to a project');
const testimonials = await getProjectTestimonials(project.slug);
const { hero } = page;
const dev = import.meta.env.DEV;
const showDemo = videoReady(page.demoVideo) || dev;
const demoPoster = await resolveImage(page.demoVideo.poster, 'med spa demo poster');
const showTranscript = Boolean(page.demoVideo.transcript) && (dev || !hasPlaceholder(page.demoVideo.transcript));
// Fixed tilts for the platform chips, as on the homepage.
const tilts = [-2.5, 2, -1.5, 3, -3];
---

<SiteLayout title={page.seo.title} description={page.seo.description} minimal>
  <!-- 1. Hero -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <p class="pill for"><span class="pill-dot" aria-hidden="true"></span><span data-template={hero.personalisedEyebrow}>{hero.eyebrow}</span></p>
    <script is:inline>
      // Static page, so this runs in the visitor's browser. The name is checked and only ever set as text.
      (function () {
        var el = document.currentScript.previousElementSibling.lastElementChild;
        var spa = (new URLSearchParams(location.search).get('spa') || '').trim();
        if (!spa || !/^[\p{L}\p{N} '’&-]+$/u.test(spa)) return;
        spa = spa.slice(0, 40).trim();
        el.textContent = el.dataset.template.replace('{spa}', function () {
          return spa;
        });
      })();
    </script>
    <h1 id="hero-title">{hero.headline}</h1>
    <p class="sub">{hero.subline}</p>
    <div class="actions">
      <a class="btn btn-primary" href="#contact" data-book>{hero.primaryCta}</a>
      {showDemo && <a class="btn btn-secondary" href="#demo">{hero.secondaryCta}</a>}
    </div>
  </section>

  <!-- 2. Demo video -->
  {showDemo && (
    <section class="demo wrap" id="demo" aria-labelledby="demo-title">
      <div class="demo-panel">
        <VideoPlayer
          videoId={page.demoVideo.youtubeId}
          poster={demoPoster}
          duration={page.demoVideo.durationLabel}
          label={`Play demo video: ${page.demoVideo.title}`}
          title={page.demoVideo.title}
          tag={project.typeLabel}
          posterPosition="50% 50%"
          sizes="(min-width: 1100px) 1000px, 92vw"
        />
      </div>
      <div class="demo-caption">
        <h2 id="demo-title">{page.demoVideo.title}</h2>
        {showTranscript && (
          <details class="transcript">
            <summary>Read the transcript</summary>
            <p><Placeholder text={page.demoVideo.transcript} /></p>
          </details>
        )}
      </div>
    </section>
  )}

  <!-- 3. Where bookings leak -->
  <section class="split section wrap" aria-labelledby="leaks-title">
    <h2 class="h2 split-head" id="leaks-title" data-reveal>{page.leaks.heading}</h2>
    <ul class="ruled big">
      {page.leaks.items.map((item) => <li data-reveal>{item}</li>)}
    </ul>
  </section>

  <!-- 4. The system -->
  <section class="system" aria-labelledby="system-title">
    <div class="wrap section">
      <h2 class="h2 center" id="system-title" data-reveal>{page.system.heading}</h2>
      <ol class="flow">
        {page.system.steps.map((step, i) => (
          <li data-reveal>
            <span class="node" aria-hidden="true">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Where to start -->
  <section class="start section wrap" aria-labelledby="start-title">
    <h2 class="h2 center" id="start-title" data-reveal>{page.offers.heading}</h2>
    <ol class="offers">
      {page.offers.items.map((item, i) => (
        <li class:list={['offer', { first: i === 0 }]} data-reveal>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="also" data-reveal>{page.offers.alsoLine}</p>
  </section>

  <!-- 6. Works with what you use -->
  <section class="platforms section wrap" aria-labelledby="platforms-title">
    <h2 class="h2 center" id="platforms-title" data-reveal>{page.platforms.heading}</h2>
    <ul class="chips" aria-label="Booking platforms">
      {page.platforms.chips.map((chip, i) => (
        <li style={`--tilt:${tilts[i % tilts.length]}deg; --i:${i}`}>
          <span class="pill"><span class="pill-dot" aria-hidden="true"></span>{chip}</span>
        </li>
      ))}
    </ul>
    <p class="platforms-text" data-reveal>{page.platforms.text}</p>
  </section>

  <!-- 7. Handled carefully -->
  <section class="split section wrap" aria-labelledby="careful-title">
    <h2 class="h2 split-head" id="careful-title" data-reveal>{page.safeguards.heading}</h2>
    <ul class="ruled">
      {page.safeguards.items.map((item) => <li data-reveal>{item}</li>)}
    </ul>
  </section>

  <!-- 8. Proof -->
  <section class="proof section wrap" aria-labelledby="proof-title">
    <h2 class="h2 center" id="proof-title" data-reveal>{page.proof.heading}</h2>
    <div class="proof-grid">
      <a class="proof-card" href={`/work/${project.slug}`} data-reveal>
        <div class="frame">
          {project.cover ? (
            <Image class="cover" src={project.cover.src} alt={project.cover.alt} widths={[480, 720, 1080]} sizes="(min-width: 860px) 560px, 90vw" format="webp" quality={80} />
          ) : (
            <span class="cover empty mono-label">{dev && `[Cover · ${project.cardTitle}]`}</span>
          )}
        </div>
        <div class="meta">
          <h3>{project.cardTitle}</h3>
          <span class="tag">{project.typeLabel}</span>
        </div>
      </a>
      <p class="proof-line" data-reveal>{page.proof.line}</p>
    </div>
  </section>

  <Testimonials eyebrow={home.reviews.eyebrow} heading={home.reviews.heading} items={testimonials} />

  <!-- 9. FAQ -->
  <section class="faq section wrap" aria-labelledby="faq-title">
    <h2 class="h2 center" id="faq-title" data-reveal>{page.faq.heading}</h2>
    <div class="items">
      {page.faq.items.map((item) => (
        <details data-reveal>
          <summary>
            <span>{item.q}</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path class="v" d="M12 5v14"></path><path d="M5 12h14"></path></svg>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- 10. Final call to action, with the calendar inline -->
  <BookingCta cta={page.finalCta} note={page.finalCta.emailLine} />
</SiteLayout>

<style>
  .center {
    text-align: center;
  }
  .h2 {
    max-width: 20ch;
    margin-inline: auto;
  }

  /* 1. Hero */
  .hero {
    display: grid;
    justify-items: center;
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
    text-align: center;
  }
  .for {
    white-space: normal;
  }
  h1 {
    max-width: 15ch;
    margin-top: 1.75rem;
    font-size: clamp(2.5rem, 6vw, 5.25rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .sub {
    max-width: 36rem;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 2rem;
  }

  /* 2. Demo: the video sits on a --panel mat, like the homepage's project panel. */
  .demo {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .demo-panel {
    max-width: 1056px;
    margin-inline: auto;
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--panel);
  }
  .demo-panel :global(.frame) {
    box-shadow: var(--shadow-image);
  }
  .demo-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    max-width: 1056px;
    margin: 1rem auto 0;
  }
  .demo-caption h2 {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .transcript summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .transcript p {
    max-width: 60ch;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* 3 and 7. Heading on the left, a ruled list on the right. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .split-head {
    max-width: 10ch;
    margin: 0;
  }
  .ruled {
    border-bottom: 1px solid var(--line);
  }
  .ruled li {
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 1.0625rem;
  }
  .ruled.big li {
    padding-block: 1.5rem;
    font-family: var(--font-geist);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* 4. The system: numbered nodes on a dashed line, over the middle wash. */
  .system {
    position: relative;
    isolation: isolate;
  }
  .system::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--wash-mid);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 9rem);
    mask-image: linear-gradient(to bottom, transparent, #000 9rem);
  }
  .flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 3.5rem;
  }
  .flow::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 22px;
    right: 22px;
    border-top: 1.5px dashed var(--ink);
  }
  .flow li {
    position: relative;
  }
  .node {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--card);
    box-shadow: var(--shadow-chip);
    font-family: var(--font-geist);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .flow li:first-child .node {
    background: var(--btn);
    color: var(--btn-text);
  }
  .flow h3 {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .flow p {
    margin-top: 0.375rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* 5. Where to start: the first offer is the recommended starting point, so it leads. */
  .offers {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 3.5rem;
  }
  .offer {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    min-height: 260px;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--card);
  }
  .offer.first {
    border-color: transparent;
    background: var(--panel);
  }
  .num {
    font-family: var(--font-geist);
    font-size: 3rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .offer h3 {
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .offer p {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .offer.first p {
    color: var(--ink);
  }
  .also {
    margin: 1.75rem auto 0;
    color: var(--muted);
    font-size: 0.9375rem;
    text-align: center;
  }

  /* 6. Platforms: floating chips, as on the homepage. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem 1rem;
    margin-top: 2.5rem;
    padding-bottom: 14px;
  }
  .chips li {
    rotate: var(--tilt);
  }
  .chips li:nth-child(even) {
    translate: 0 14px;
  }
  .chips .pill {
    padding: 0.625rem 1.125rem;
    font-size: 1rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .chips .pill {
      animation: float 5.6s ease-in-out infinite alternate;
      animation-delay: calc(var(--i) * -0.9s);
    }
  }
  @keyframes float {
    from {
      transform: translateY(-4px);
    }
    to {
      transform: translateY(4px);
    }
  }
  .platforms-text {
    max-width: 40rem;
    margin: 2.5rem auto 0;
    color: var(--muted);
    font-size: 1.0625rem;
    text-align: center;
  }

  /* 8. Proof */
  .proof-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: center;
    margin-top: 3.5rem;
  }
  .proof-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .frame {
    padding: 28px;
    border-radius: 20px;
    background: var(--soft);
  }
  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: var(--shadow-image);
    transition: transform 500ms var(--ease-out);
  }
  .empty {
    display: grid;
    place-items: center;
    padding: 1rem;
    border: 1.5px dashed color-mix(in srgb, var(--ink) 22%, transparent);
    background: color-mix(in srgb, var(--card) 45%, transparent);
    box-shadow: none;
    color: var(--muted);
    font-weight: 400;
  }
  @media (hover: hover) and (pointer: fine) {
    .proof-card:hover .cover:not(.empty) {
      transform: translateY(-6px) scale(1.02);
    }
    .proof-card:hover h3 {
      text-decoration: underline;
      text-underline-offset: 4px;
      text-decoration-thickness: 1px;
    }
  }
  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }
  .meta h3 {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .proof-line {
    font-family: var(--font-geist);
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  /* 9. FAQ */
  .items {
    max-width: 52rem;
    margin: 3rem auto 0;
    border-bottom: 1px solid var(--line);
  }
  .items details {
    border-top: 1px solid var(--line);
  }
  .items summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
    font-family: var(--font-geist);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
  }
  .items summary::-webkit-details-marker {
    display: none;
  }
  .items summary svg {
    flex: none;
    transition: rotate var(--dur-ui) var(--ease-out);
  }
  .items details[open] summary svg {
    rotate: 45deg;
  }
  .items details p {
    max-width: 60ch;
    padding-bottom: 1.25rem;
    color: var(--muted);
  }

  @media (max-width: 959px) {
    .flow {
      grid-template-columns: 1fr;
      gap: 0;
      max-width: 34rem;
      margin-inline: auto;
    }
    .flow::before {
      display: none;
    }
    /* One dashed segment from each node down to the next. */
    .flow li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 44px;
      bottom: 0;
      left: 21px;
      border-left: 1.5px dashed var(--ink);
    }
    .flow li {
      display: grid;
      grid-template-columns: 44px 1fr;
      column-gap: 1.25rem;
      padding-bottom: 1.75rem;
    }
    .flow li:last-child {
      padding-bottom: 0;
    }
    .node {
      grid-row: 1 / 3;
    }
    .flow h3 {
      margin-top: 0.625rem;
    }
    .offers {
      grid-template-columns: 1fr;
    }
    .offer {
      min-height: 0;
      gap: 1.5rem;
    }
  }
  @media (max-width: 759px) {
    .split {
      grid-template-columns: 1fr;
    }
    .split-head {
      max-width: none;
    }
    .demo-panel {
      padding: 12px;
      border-radius: 22px;
    }
    .actions {
      flex-direction: column;
      width: 100%;
    }
    .actions .btn {
      width: 100%;
    }
    .chips {
      gap: 0.625rem;
      padding-bottom: 0;
    }
    .chips li,
    .chips li:nth-child(even) {
      rotate: none;
      translate: none;
    }
    .chips .pill {
      padding: 0.5rem 0.875rem;
      font-size: 0.9375rem;
    }
    .proof-grid {
      grid-template-columns: 1fr;
    }
    .frame {
      padding: 16px;
    }
  }
</style>

# Static files only: Cloudflare applies this file to assets, not to responses from the Worker
# (/keystatic and /api/keystatic set their own noindex header in src/middleware.ts).
# Long cache for /_astro/* is added by the Astro adapter at build time.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://link.msgsndr.com https://*.leadconnectorhq.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; font-src 'self'; frame-src https://www.youtube-nocookie.com https://*.leadconnectorhq.com https://link.msgsndr.com https://*.msgsndr.com; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests

/keystatic*
  X-Robots-Tag: noindex, nofollow

/api/keystatic*
  X-Robots-Tag: noindex, nofollow
